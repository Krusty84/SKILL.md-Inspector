{
  "name": "skill-md-inspector",
  "displayName": "SKILL.md Inspector",
  "description": "Lint, validate, and inspect SKILL.md files for AI agent skill systems.",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "Sedoykin Alexey",
  "repository": {
    "type": "git",
    "url": "https://github.com/krusty84/skill-md-inspector.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "skill",
    "SKILL.md",
    "agent",
    "linter",
    "markdown"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/SKILL.md",
    "onCommand:skillMdInspector.refreshNavigator",
    "onCommand:skillMdInspector.addToFavorites",
    "onCommand:skillMdInspector.toggleFavorite",
    "onView:skillMdInspectorFavorites",
    "onView:skillMdInspectorWorkspace",
    "onCommand:skillMdInspector.workspace.selectSkillsFolder",
    "onView:skillMdInspectorInstalledAgents",
    "onView:skillMdInspectorOpenCodeSessions",
    "onCommand:skillMdInspector.openCode.selectSessionsFolder",
    "onCommand:skillMdInspector.openCode.openReport",
    "onCommand:skillMdInspector.openCode.openRawJson",
    "onCommand:skillMdInspector.openCode.clearSessionsFolder",
    "onCommand:skillMdInspector.openCode.refreshSessions"
  ],
  "contributes": {
    "commands": [
      {
        "command": "skillMdInspector.validateCurrentSkill",
        "title": "Validate Current Skill",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.validateWorkspaceSkills",
        "title": "Validate Workspace Skills",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.insertTemplate",
        "title": "Insert SKILL.md Template",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.showSkillReport",
        "title": "Show Skill Report",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.improveDescriptionLocally",
        "title": "Improve Description Locally",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.showWorkspaceReport",
        "title": "Show Workspace Report",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.exportSkillsIndex",
        "title": "Export Skills Index",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.refreshSkills",
        "title": "Refresh Skills",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.openTemplateSettings",
        "title": "Open Template Settings",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.resetTemplates",
        "title": "Reset Templates to Defaults",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.addToFavorites",
        "title": "Add SKILL.md to Favorites",
        "category": "SKILL.md Inspector",
        "icon": "$(star-empty)"
      },
      {
        "command": "skillMdInspector.removeFromFavorites",
        "title": "Remove from Favorites",
        "category": "SKILL.md Inspector",
        "icon": "$(star-full)"
      },
      {
        "command": "skillMdInspector.toggleFavorite",
        "title": "Add or Remove Favorite",
        "category": "SKILL.md Inspector",
        "icon": "$(star)"
      },
      {
        "command": "skillMdInspector.clearFavorites",
        "title": "Clear All Favorites",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.refreshNavigator",
        "title": "Refresh Inspector Views",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.refreshFavorites",
        "title": "Refresh Favorites",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.refreshWorkspace",
        "title": "Refresh Workspace",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.refreshInstalledAgents",
        "title": "Refresh Installed Agents",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.workspace.selectSkillsFolder",
        "title": "Select SKILLs Folder",
        "category": "SKILL.md Inspector",
        "icon": "$(folder-opened)"
      },
      {
        "command": "skillMdInspector.workspace.newFile",
        "title": "New File",
        "category": "SKILL.md Inspector",
        "icon": "$(new-file)"
      },
      {
        "command": "skillMdInspector.workspace.newFolder",
        "title": "New Folder",
        "category": "SKILL.md Inspector",
        "icon": "$(new-folder)"
      },
      {
        "command": "skillMdInspector.workspace.addFolders",
        "title": "Add Folder to Workspace...",
        "category": "SKILL.md Inspector",
        "icon": "$(folder-library)"
      },
      {
        "command": "skillMdInspector.workspace.openFolderInNewWindow",
        "title": "Open Folder in New Window...",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.removeFolder",
        "title": "Remove Folder from Workspace",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.open",
        "title": "Open",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openToSide",
        "title": "Open to the Side",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.rename",
        "title": "Rename",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.delete",
        "title": "Delete",
        "category": "SKILL.md Inspector",
        "icon": "$(trash)"
      },
      {
        "command": "skillMdInspector.workspace.copy",
        "title": "Copy",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.cut",
        "title": "Cut",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.paste",
        "title": "Paste",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.copyPath",
        "title": "Copy Path",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "SKILL.md Inspector",
        "icon": "$(terminal)"
      },
      {
        "command": "skillMdInspector.workspace.refreshFolder",
        "title": "Refresh",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.workspace.newFileContext",
        "title": "New File...",
        "category": "SKILL.md Inspector",
        "icon": "$(new-file)"
      },
      {
        "command": "skillMdInspector.workspace.newFolderContext",
        "title": "New Folder...",
        "category": "SKILL.md Inspector",
        "icon": "$(new-folder)"
      },
      {
        "command": "skillMdInspector.workspace.renameContext",
        "title": "Rename...",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openPreview",
        "title": "Open Preview",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openWith",
        "title": "Open With...",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.revealInOS.windows",
        "title": "Reveal in File Explorer",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.revealInOS.mac",
        "title": "Reveal in Finder",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.revealInOS.linux",
        "title": "Open Containing Folder",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openImagesPreview",
        "title": "Open in Images Preview",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.selectForCompare",
        "title": "Select for Compare",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.compareWithSelected",
        "title": "Compare with Selected",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.findFileReferences",
        "title": "Find File References",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openTimeline",
        "title": "Open Timeline",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.findInFolder",
        "title": "Find in Folder...",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.openCode.selectSessionsFolder",
        "title": "Select OpenCode Sessions Folder",
        "category": "SKILL.md Inspector",
        "icon": "$(folder-opened)"
      },
      {
        "command": "skillMdInspector.openCode.clearSessionsFolder",
        "title": "Clear OpenCode Sessions Folder",
        "category": "SKILL.md Inspector",
        "icon": "$(clear-all)"
      },
      {
        "command": "skillMdInspector.openCode.refreshSessions",
        "title": "Refresh OpenCode Sessions",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.openCode.openReport",
        "title": "Open OpenCode Session Report",
        "category": "SKILL.md Inspector",
        "icon": "$(preview)"
      },
      {
        "command": "skillMdInspector.openCode.openRawJson",
        "title": "Open Raw OpenCode Session JSON",
        "category": "SKILL.md Inspector",
        "icon": "$(json)"
      },
      {
        "command": "skillMdInspector.openCode.revealInOS",
        "title": "Reveal in Operating System",
        "category": "SKILL.md Inspector",
        "icon": "$(go-to-file)"
      },
      {
        "command": "skillMdInspector.openCode.copySessionId",
        "title": "Copy Session ID",
        "category": "SKILL.md Inspector",
        "icon": "$(copy)"
      },
      {
        "command": "skillMdInspector.openCode.copyFilePath",
        "title": "Copy File Path",
        "category": "SKILL.md Inspector",
        "icon": "$(copy)"
      }
    ],
    "views": {
      "skillMdInspector": [
        {
          "id": "skillMdInspectorFavorites",
          "name": "FAVORITES",
          "contextualTitle": "SKILL.md INSPECTOR"
        },
        {
          "id": "skillMdInspectorWorkspace",
          "name": "WORKSPACE",
          "contextualTitle": "SKILL.md INSPECTOR"
        },
        {
          "id": "skillMdInspectorInstalledAgents",
          "name": "INSTALLED AGENTS",
          "contextualTitle": "SKILL.md INSPECTOR"
        },
        {
          "id": "skillMdInspectorOpenCodeSessions",
          "name": "OPENCODE SESSIONS",
          "contextualTitle": "OpenCode Sessions"
        }
      ],
      "skillMdInspectorPanel": [
        {
          "id": "skillMdInspectorSkills",
          "name": "SKILL.md Skills"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "skillMdInspector.refreshSkills",
          "when": "view == skillMdInspectorSkills",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.refreshFavorites",
          "when": "view == skillMdInspectorFavorites",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.clearFavorites",
          "when": "view == skillMdInspectorFavorites && skillMdInspector.hasFavorites",
          "group": "secondary"
        },
        {
          "command": "skillMdInspector.refreshInstalledAgents",
          "when": "view == skillMdInspectorInstalledAgents",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.workspace.selectSkillsFolder",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "skillMdInspector.workspace.newFile",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "skillMdInspector.workspace.newFolder",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "skillMdInspector.refreshWorkspace",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@4"
        },
        {
          "command": "skillMdInspector.workspace.addFolders",
          "when": "view == skillMdInspectorWorkspace",
          "group": "secondary@1"
        },
        {
          "command": "skillMdInspector.workspace.openFolderInNewWindow",
          "when": "view == skillMdInspectorWorkspace",
          "group": "secondary@2"
        },
        {
          "command": "skillMdInspector.openCode.selectSessionsFolder",
          "when": "view == skillMdInspectorOpenCodeSessions",
          "group": "navigation@1"
        },
        {
          "command": "skillMdInspector.openCode.refreshSessions",
          "when": "view == skillMdInspectorOpenCodeSessions",
          "group": "navigation@2"
        },
        {
          "command": "skillMdInspector.openCode.clearSessionsFolder",
          "when": "view == skillMdInspectorOpenCodeSessions && skillMdInspector.openCode.hasFolder",
          "group": "secondary@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "skillMdInspector/context",
          "when": "resourceFilename == SKILL.md && activeViewlet == workbench.view.extension.skillMdInspector",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "skillMdInspector/context",
          "when": "resourceFilename == SKILL.md && activeViewlet == workbench.view.extension.skillMdInspector",
          "group": "navigation"
        }
      ],
      "skillMdInspector/context": [
        {
          "command": "skillMdInspector.validateCurrentSkill",
          "group": "1_validation@1"
        },
        {
          "command": "skillMdInspector.validateWorkspaceSkills",
          "group": "1_validation@2"
        },
        {
          "command": "skillMdInspector.insertTemplate",
          "group": "2_editing@1"
        },
        {
          "command": "skillMdInspector.improveDescriptionLocally",
          "group": "2_editing@2"
        },
        {
          "command": "skillMdInspector.showSkillReport",
          "group": "3_reports@1"
        },
        {
          "command": "skillMdInspector.showWorkspaceReport",
          "group": "3_reports@2"
        },
        {
          "command": "skillMdInspector.exportSkillsIndex",
          "group": "3_reports@3"
        },
        {
          "command": "skillMdInspector.refreshSkills",
          "group": "4_maintenance@1"
        },
        {
          "command": "skillMdInspector.openTemplateSettings",
          "group": "5_templates@1"
        },
        {
          "command": "skillMdInspector.resetTemplates",
          "group": "5_templates@2"
        },
        {
          "command": "skillMdInspector.toggleFavorite",
          "group": "4_maintenance@2"
        }
      ],
      "view/item/context": [
        {
          "submenu": "skillMdInspector/skillItemContext",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile)",
          "group": "9_inspector@10"
        },
        {
          "submenu": "skillMdInspector/skillItemContext",
          "when": "view == skillMdInspectorFavorites && viewItem == skillMdInspector.favoriteSkillFile",
          "group": "9_inspector@10"
        },
        {
          "submenu": "skillMdInspector/skillItemContext",
          "when": "view == skillMdInspectorInstalledAgents && (viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile)",
          "group": "9_inspector@10"
        },
        {
          "command": "skillMdInspector.removeFromFavorites",
          "when": "view == skillMdInspectorFavorites && viewItem == skillMdInspector.missingFavorite",
          "group": "favorites@2"
        },
        {
          "command": "skillMdInspector.workspace.openPreview",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && resourceExtname == .md && skillMdInspector.canOpenMarkdownPreview",
          "group": "navigation@10"
        },
        {
          "command": "skillMdInspector.workspace.openToSide",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile)",
          "group": "navigation@20"
        },
        {
          "command": "skillMdInspector.workspace.openWith",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && skillMdInspector.canOpenWith",
          "group": "navigation@30"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.windows",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && skillMdInspector.canRevealInOS && (resourceScheme == file || resourceScheme == vscode-userdata) && isWindows",
          "group": "navigation@40"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.mac",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && skillMdInspector.canRevealInOS && (resourceScheme == file || resourceScheme == vscode-userdata) && isMac",
          "group": "navigation@40"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.linux",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && skillMdInspector.canRevealInOS && (resourceScheme == file || resourceScheme == vscode-userdata) && isLinux",
          "group": "navigation@40"
        },
        {
          "command": "skillMdInspector.workspace.openInTerminal",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile)",
          "group": "navigation@50"
        },
        {
          "command": "skillMdInspector.workspace.newFileContext",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory)",
          "group": "navigation@10"
        },
        {
          "command": "skillMdInspector.workspace.newFolderContext",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory)",
          "group": "navigation@20"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.windows",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory) && skillMdInspector.canRevealInOS && (resourceScheme == file || resourceScheme == vscode-userdata) && isWindows",
          "group": "navigation@30"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.mac",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory) && skillMdInspector.canRevealInOS && (resourceScheme == file || resourceScheme == vscode-userdata) && isMac",
          "group": "navigation@30"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.linux",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory) && skillMdInspector.canRevealInOS && (resourceScheme == file || resourceScheme == vscode-userdata) && isLinux",
          "group": "navigation@30"
        },
        {
          "command": "skillMdInspector.workspace.openImagesPreview",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory) && skillMdInspector.canOpenImagesPreview",
          "group": "navigation@40"
        },
        {
          "command": "skillMdInspector.workspace.openImagesPreview",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && (resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .jpe || resourceExtname == .gif || resourceExtname == .webp || resourceExtname == .svg || resourceExtname == .bmp || resourceExtname == .ico || resourceExtname == .mp4 || resourceExtname == .webm || resourceExtname == .mov) && skillMdInspector.canOpenImagesPreview",
          "group": "navigation@40"
        },
        {
          "command": "skillMdInspector.workspace.openInTerminal",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory)",
          "group": "navigation@50"
        },
        {
          "command": "skillMdInspector.workspace.selectForCompare",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && !skillMdInspector.workspaceHasCompareSource && skillMdInspector.canCompareFiles",
          "group": "3_compare@10"
        },
        {
          "command": "skillMdInspector.workspace.compareWithSelected",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && skillMdInspector.workspaceHasCompareSource && skillMdInspector.canCompareFiles",
          "group": "3_compare@20"
        },
        {
          "command": "skillMdInspector.workspace.findFileReferences",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && resourceExtname == .md && skillMdInspector.canFindMarkdownFileReferences",
          "group": "4_search@10"
        },
        {
          "command": "skillMdInspector.workspace.findInFolder",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory)",
          "group": "4_search@10"
        },
        {
          "command": "skillMdInspector.workspace.openTimeline",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) && skillMdInspector.canOpenTimeline",
          "group": "4_timeline@10"
        },
        {
          "command": "skillMdInspector.workspace.cut",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "5_cutcopypaste@10"
        },
        {
          "command": "skillMdInspector.workspace.copy",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "5_cutcopypaste@20"
        },
        {
          "command": "skillMdInspector.workspace.paste",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory) && skillMdInspector.workspaceClipboardHasItems",
          "group": "5_cutcopypaste@30"
        },
        {
          "command": "skillMdInspector.workspace.copyPath",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceRoot",
          "group": "6_copypath@10"
        },
        {
          "command": "skillMdInspector.workspace.copyRelativePath",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "6_copypath@20"
        },
        {
          "command": "skillMdInspector.workspace.renameContext",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "7_modification@10"
        },
        {
          "command": "skillMdInspector.workspace.delete",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "7_modification@20"
        },
        {
          "command": "skillMdInspector.workspace.addFolders",
          "when": "view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceRoot",
          "group": "7_modification@30"
        },
        {
          "command": "skillMdInspector.workspace.removeFolder",
          "when": "view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceRoot",
          "group": "7_modification@40"
        },
        {
          "command": "skillMdInspector.openCode.openReport",
          "when": "view == skillMdInspectorOpenCodeSessions && viewItem =~ /skillMdInspector.openCodeSession/",
          "group": "navigation@1"
        },
        {
          "command": "skillMdInspector.openCode.openRawJson",
          "when": "view == skillMdInspectorOpenCodeSessions && viewItem =~ /skillMdInspector.openCodeSession/",
          "group": "navigation@2"
        },
        {
          "command": "skillMdInspector.openCode.revealInOS",
          "when": "view == skillMdInspectorOpenCodeSessions && viewItem == skillMdInspector.openCodeSession.file",
          "group": "2_file@1"
        },
        {
          "command": "skillMdInspector.openCode.copySessionId",
          "when": "view == skillMdInspectorOpenCodeSessions && viewItem =~ /skillMdInspector.openCodeSession/",
          "group": "3_copy@1"
        },
        {
          "command": "skillMdInspector.openCode.copyFilePath",
          "when": "view == skillMdInspectorOpenCodeSessions && viewItem =~ /skillMdInspector.openCodeSession/",
          "group": "3_copy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "skillMdInspector.workspace.newFileContext",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.newFolderContext",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.renameContext",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.openPreview",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.openWith",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.windows",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.mac",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS.linux",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.openImagesPreview",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.selectForCompare",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.compareWithSelected",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.findFileReferences",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.openTimeline",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.findInFolder",
          "when": "false"
        },
        {
          "command": "skillMdInspector.workspace.revealInOS",
          "when": "false"
        }
      ],
      "skillMdInspector/skillItemContext": [
        {
          "command": "skillMdInspector.validateCurrentSkill",
          "group": "1_validation@1"
        },
        {
          "command": "skillMdInspector.insertTemplate",
          "group": "2_editing@1"
        },
        {
          "command": "skillMdInspector.improveDescriptionLocally",
          "group": "2_editing@2"
        },
        {
          "command": "skillMdInspector.showSkillReport",
          "group": "3_reports@1"
        },
        {
          "command": "skillMdInspector.addToFavorites",
          "when": "viewItem == skillMdInspector.skillFile",
          "group": "4_favorites@10"
        },
        {
          "command": "skillMdInspector.removeFromFavorites",
          "when": "viewItem == skillMdInspector.favoriteSkillFile",
          "group": "4_favorites@20"
        }
      ]
    },
    "configuration": {
      "title": "SKILL.md Inspector",
      "properties": {
        "skillMdInspector.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable deterministic validation of SKILL.md files."
        },
        "skillMdInspector.validation.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-run validation whenever a SKILL.md file is saved."
        },
        "skillMdInspector.profile": {
          "type": "string",
          "default": "generic",
          "enum": [
            "generic",
            "vscode",
            "claude",
            "codex"
          ],
          "description": "Validation profile applied to SKILL.md files."
        },
        "skillMdInspector.description.minLength": {
          "type": "number",
          "default": 40,
          "description": "Minimum recommended length of the description field."
        },
        "skillMdInspector.description.maxLength": {
          "type": "number",
          "default": 1024,
          "description": "Maximum allowed length of the description field."
        },
        "skillMdInspector.name.maxLength": {
          "type": "number",
          "default": 64,
          "description": "Maximum allowed length of the name field."
        },
        "skillMdInspector.description.language": {
          "type": "string",
          "enum": [
            "en",
            "auto"
          ],
          "default": "auto",
          "description": "Language used by description heuristics. \"en\" forces English analysis; \"auto\" detects a non-English description and marks its quality score as language-limited."
        },
        "skillMdInspector.resources.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "Glob patterns for files and folders to exclude from resource discovery. Setting this replaces the defaults."
        },
        "skillMdInspector.discovery.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/.vscode-test/**"
          ],
          "description": "Glob patterns for directories to skip when discovering SKILL.md files across the workspace (the tree view and workspace report). Setting this replaces the defaults."
        },
        "skillMdInspector.names.similarityThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Similarity (0–1) at or above which two different skill names are flagged as confusingly similar. Exact duplicates are always reported."
        },
        "skillMdInspector.collision.threshold": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "Composite similarity (0–1) at or above which two skills are reported as a potential collision."
        },
        "skillMdInspector.collision.ngramSize": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 5,
          "description": "Character n-gram size used by the collision character-similarity metric."
        },
        "skillMdInspector.collision.boundarySeparationWeight": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly mutually-exclusive \"Do not use for...\" boundaries reduce the composite collision score (0 = ignore boundaries, 1 = fully cancel overlap when scopes are mutually excluded)."
        },
        "skillMdInspector.collision.weights": {
          "type": "object",
          "properties": {
            "jaccard": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of pairwise token Jaccard."
            },
            "cosine": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of TF-IDF cosine."
            },
            "charNgram": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of character n-gram similarity."
            },
            "nameSimilarity": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of skill-name similarity."
            }
          },
          "additionalProperties": false,
          "default": {
            "jaccard": 0.3,
            "cosine": 0.3,
            "charNgram": 0.2,
            "nameSimilarity": 0.2
          },
          "description": "Relative weights blended into the composite collision score. Normalized to sum to 1 at runtime, so only the ratios matter."
        },
        "skillMdInspector.body.strictness": {
          "type": "string",
          "enum": [
            "off",
            "recommended",
            "strict"
          ],
          "default": "recommended",
          "description": "How strictly to surface advisory body-section recommendations (examples, when-to-use, etc.). \"off\" disables them; \"recommended\" uses information-level diagnostics; \"strict\" uses warnings. Structural body errors are unaffected."
        },
        "skillMdInspector.severityOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "off"
            ]
          },
          "default": {},
          "description": "Override the severity of diagnostics by code, or disable one with \"off\" (e.g. { \"skill.description.vague\": \"information\" }). Specification errors are protected unless skillMdInspector.severity.allowSpecificationOverrides is enabled."
        },
        "skillMdInspector.severity.allowSpecificationOverrides": {
          "type": "boolean",
          "default": false,
          "description": "Allow skillMdInspector.severityOverrides to downgrade or disable specification-level errors (an invalid file). Off by default so structural errors are not hidden accidentally."
        },
        "skillMdInspector.experimental.llmReview.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for future LLM-assisted review. Not implemented in MVP1."
        },
        "skillMdInspector.templates": {
          "type": "array",
          "default": [],
          "description": "Custom SKILL.md templates. A non-empty array replaces the bundled templates.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "frontmatter",
              "body"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique template identifier."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Template name displayed in the selection list."
              },
              "description": {
                "type": "string",
                "description": "Optional explanation displayed in the selection list."
              },
              "frontmatter": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "YAML frontmatter lines without the opening and closing --- delimiters."
              },
              "body": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Markdown body lines. Use an empty string to insert a blank line."
              }
            },
            "additionalProperties": false
          }
        },
        "skillMdInspector.navigator.additionalRoots": {
          "type": "array",
          "default": [],
          "description": "Additional local agent roots to show in the Installed Agents view.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "SKILL.md",
                    "AGENTS.md",
                    "CLAUDE.md"
                  ]
                }
              },
              "recursive": {
                "type": "boolean",
                "default": true
              }
            },
            "additionalProperties": false
          }
        },
        "skillMdInspector.openCode.maxSessionFileSizeMb": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum OpenCode session export file size to read, in MiB."
        },
        "skillMdInspector.openCode.maxDiscoveredSessions": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum OpenCode session JSON files to discover."
        },
        "skillMdInspector.openCode.maxPreviewCharacters": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum characters retained in OpenCode previews."
        },
        "skillMdInspector.openCode.scanRecursively": {
          "type": "boolean",
          "default": true,
          "description": "Scan the selected OpenCode sessions folder recursively."
        },
        "skillMdInspector.resources.directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "references",
            "scripts",
            "assets",
            "templates"
          ],
          "description": "Relative resource directories monitored for unreferenced bundled files. This replaces the default list; absolute paths and .. traversal are ignored."
        },
        "skillMdInspector.heuristics.dictionaries": {
          "type": "object",
          "default": {},
          "description": "Custom deterministic heuristic dictionaries. Each dictionary supports add, remove, or replace arrays; matching is case-insensitive.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "add": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remove": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "replace": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "submenus": [
      {
        "id": "skillMdInspector/context",
        "label": "SKILL.md Inspector"
      },
      {
        "id": "skillMdInspector/skillItemContext",
        "label": "SKILL.md Inspector"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillMdInspector",
          "title": "SKILL.md INSPECTOR",
          "icon": "media/skill-md-inspector.svg"
        }
      ],
      "panel": [
        {
          "id": "skillMdInspectorPanel",
          "title": "SKILL.md Inspector",
          "icon": "media/skill-md-inspector.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillMdInspectorWorkspace",
        "contents": "No SKILLs folder is selected.\n\n[Select SKILLs Folder](command:skillMdInspector.workspace.selectSkillsFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "skillMdInspectorOpenCodeSessions",
        "contents": "No OpenCode sessions folder is selected.\n\n[Select Sessions Folder](command:skillMdInspector.openCode.selectSessionsFolder)",
        "when": "!skillMdInspector.openCode.hasFolder"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run test/evaluation",
    "benchmark:static": "vitest run test/benchmarks/staticDescriptionQuality.test.ts"
  },
  "dependencies": {
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.7.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.11.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.1"
  }
}
