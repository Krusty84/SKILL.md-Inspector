{
  "name": "skill-md-inspector",
  "displayName": "SKILL.md Inspector",
  "description": "Lint, validate, and inspect SKILL.md files for AI agent skill systems.",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "Sedoykin Alexey",
  "repository": {
    "type": "git",
    "url": "https://github.com/krusty84/skill-md-inspector.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "skill",
    "SKILL.md",
    "agent",
    "linter",
    "markdown"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/SKILL.md",
    "onCommand:skillMdInspector.refreshNavigator",
    "onCommand:skillMdInspector.addToFavorites",
    "onView:skillMdInspectorFavorites",
    "onView:skillMdInspectorWorkspace",
    "onView:skillMdInspectorInstalledAgents"
  ],
  "contributes": {
    "commands": [
      {
        "command": "skillMdInspector.validateCurrentSkill",
        "title": "Validate Current Skill",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.validateWorkspaceSkills",
        "title": "Validate Workspace Skills",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.insertTemplate",
        "title": "Insert SKILL.md Template",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.showSkillReport",
        "title": "Show Skill Report",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.improveDescriptionLocally",
        "title": "Improve Description Locally",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.showWorkspaceReport",
        "title": "Show Workspace Report",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.exportSkillsIndex",
        "title": "Export Skills Index",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.refreshSkills",
        "title": "Refresh Skills",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.openTemplateSettings",
        "title": "Open Template Settings",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.resetTemplates",
        "title": "Reset Templates to Defaults",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.addToFavorites",
        "title": "Add SKILL.md to Favorites",
        "category": "SKILL.md Inspector",
        "icon": "$(star-empty)"
      },
      {
        "command": "skillMdInspector.removeFromFavorites",
        "title": "Remove from Favorites",
        "category": "SKILL.md Inspector",
        "icon": "$(star-full)"
      },
      {
        "command": "skillMdInspector.clearFavorites",
        "title": "Clear All Favorites",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.refreshNavigator",
        "title": "Refresh Inspector Views",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.refreshFavorites",
        "title": "Refresh Favorites",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.refreshWorkspace",
        "title": "Refresh Workspace",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.refreshInstalledAgents",
        "title": "Refresh Installed Agents",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "skillMdInspector.workspace.newFile",
        "title": "New File",
        "category": "SKILL.md Inspector",
        "icon": "$(new-file)"
      },
      {
        "command": "skillMdInspector.workspace.newFolder",
        "title": "New Folder",
        "category": "SKILL.md Inspector",
        "icon": "$(new-folder)"
      },
      {
        "command": "skillMdInspector.workspace.addFolders",
        "title": "Add Folder to Workspace...",
        "category": "SKILL.md Inspector",
        "icon": "$(folder-library)"
      },
      {
        "command": "skillMdInspector.workspace.openFolderInNewWindow",
        "title": "Open Folder in New Window...",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.removeFolder",
        "title": "Remove Folder from Workspace",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.open",
        "title": "Open",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openToSide",
        "title": "Open to the Side",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.rename",
        "title": "Rename",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.delete",
        "title": "Delete",
        "category": "SKILL.md Inspector",
        "icon": "$(trash)"
      },
      {
        "command": "skillMdInspector.workspace.copy",
        "title": "Copy",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.cut",
        "title": "Cut",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.paste",
        "title": "Paste",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.copyPath",
        "title": "Copy Path",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "SKILL.md Inspector"
      },
      {
        "command": "skillMdInspector.workspace.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "SKILL.md Inspector",
        "icon": "$(terminal)"
      },
      {
        "command": "skillMdInspector.workspace.refreshFolder",
        "title": "Refresh",
        "category": "SKILL.md Inspector",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "skillMdInspector": [
        {
          "id": "skillMdInspectorFavorites",
          "name": "FAVORITES",
          "contextualTitle": "SKILL.md INSPECTOR"
        },
        {
          "id": "skillMdInspectorWorkspace",
          "name": "WORKSPACE",
          "contextualTitle": "SKILL.md INSPECTOR"
        },
        {
          "id": "skillMdInspectorInstalledAgents",
          "name": "INSTALLED AGENTS",
          "contextualTitle": "SKILL.md INSPECTOR"
        }
      ],
      "skillMdInspectorPanel": [
        {
          "id": "skillMdInspectorSkills",
          "name": "SKILL.md Skills"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "skillMdInspector.refreshSkills",
          "when": "view == skillMdInspectorSkills",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.refreshFavorites",
          "when": "view == skillMdInspectorFavorites",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.clearFavorites",
          "when": "view == skillMdInspectorFavorites && skillMdInspector.hasFavorites",
          "group": "secondary"
        },
        {
          "command": "skillMdInspector.refreshInstalledAgents",
          "when": "view == skillMdInspectorInstalledAgents",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.workspace.newFile",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "skillMdInspector.workspace.newFolder",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "skillMdInspector.refreshWorkspace",
          "when": "view == skillMdInspectorWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "skillMdInspector.workspace.addFolders",
          "when": "view == skillMdInspectorWorkspace",
          "group": "secondary@1"
        },
        {
          "command": "skillMdInspector.workspace.openFolderInNewWindow",
          "when": "view == skillMdInspectorWorkspace",
          "group": "secondary@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "skillMdInspector/context",
          "when": "resourceFilename == SKILL.md && activeViewlet == workbench.view.extension.skillMdInspector",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "skillMdInspector/context",
          "when": "resourceFilename == SKILL.md && activeViewlet == workbench.view.extension.skillMdInspector",
          "group": "navigation"
        }
      ],
      "skillMdInspector/context": [
        {
          "command": "skillMdInspector.validateCurrentSkill",
          "group": "1_validation@1"
        },
        {
          "command": "skillMdInspector.validateWorkspaceSkills",
          "group": "1_validation@2"
        },
        {
          "command": "skillMdInspector.insertTemplate",
          "group": "2_editing@1"
        },
        {
          "command": "skillMdInspector.improveDescriptionLocally",
          "group": "2_editing@2"
        },
        {
          "command": "skillMdInspector.showSkillReport",
          "group": "3_reports@1"
        },
        {
          "command": "skillMdInspector.showWorkspaceReport",
          "group": "3_reports@2"
        },
        {
          "command": "skillMdInspector.exportSkillsIndex",
          "group": "3_reports@3"
        },
        {
          "command": "skillMdInspector.refreshSkills",
          "group": "4_maintenance@1"
        },
        {
          "command": "skillMdInspector.openTemplateSettings",
          "group": "5_templates@1"
        },
        {
          "command": "skillMdInspector.resetTemplates",
          "group": "5_templates@2"
        },
        {
          "command": "skillMdInspector.addToFavorites",
          "group": "4_maintenance@2",
          "when": "resourceFilename == SKILL.md && viewItem != skillMdInspector.favorite && viewItem != skillMdInspector.favoriteSkillFile"
        },
        {
          "command": "skillMdInspector.removeFromFavorites",
          "when": "resourceFilename == SKILL.md && (viewItem == skillMdInspector.favorite || viewItem == skillMdInspector.favoriteSkillFile)",
          "group": "4_maintenance@3"
        }
      ],
      "view/item/context": [
        {
          "submenu": "skillMdInspector/context",
          "when": "view == skillMdInspectorFavorites && viewItem == skillMdInspector.favorite",
          "group": "navigation"
        },
        {
          "submenu": "skillMdInspector/context",
          "when": "view == skillMdInspectorInstalledAgents && (viewItem == skillMdInspector.installedSkillFile || viewItem == skillMdInspector.favorite)",
          "group": "navigation"
        },
        {
          "command": "skillMdInspector.removeFromFavorites",
          "when": "view == skillMdInspectorFavorites && (viewItem == skillMdInspector.favorite || viewItem == skillMdInspector.missingFavorite)",
          "group": "favorites@2"
        },
        {
          "command": "skillMdInspector.workspace.open",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile)",
          "group": "1_open@1"
        },
        {
          "command": "skillMdInspector.workspace.openToSide",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile)",
          "group": "1_open@2"
        },
        {
          "command": "skillMdInspector.workspace.newFile",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory || (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile))",
          "group": "2_create@1"
        },
        {
          "command": "skillMdInspector.workspace.newFolder",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory || (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile))",
          "group": "2_create@2"
        },
        {
          "command": "skillMdInspector.workspace.openInTerminal",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory || (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile))",
          "group": "3_terminal@1"
        },
        {
          "command": "skillMdInspector.workspace.cut",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "4_clipboard@1"
        },
        {
          "command": "skillMdInspector.workspace.copy",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "4_clipboard@2"
        },
        {
          "command": "skillMdInspector.workspace.paste",
          "when": "view == skillMdInspectorWorkspace && skillMdInspector.workspaceClipboardHasItems && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory || viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile)",
          "group": "4_clipboard@3"
        },
        {
          "command": "skillMdInspector.workspace.copyPath",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceRoot",
          "group": "5_path@1"
        },
        {
          "command": "skillMdInspector.workspace.copyRelativePath",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "5_path@2"
        },
        {
          "command": "skillMdInspector.workspace.rename",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "6_manage@1"
        },
        {
          "command": "skillMdInspector.workspace.delete",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceFile || viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile || viewItem == skillMdInspector.agentsFile) || view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceDirectory",
          "group": "6_manage@2"
        },
        {
          "command": "skillMdInspector.workspace.addFolders",
          "when": "view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceRoot",
          "group": "7_workspace@1"
        },
        {
          "command": "skillMdInspector.workspace.removeFolder",
          "when": "view == skillMdInspectorWorkspace && viewItem == skillMdInspector.workspaceRoot",
          "group": "7_workspace@2"
        },
        {
          "command": "skillMdInspector.workspace.refreshFolder",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.workspaceRoot || viewItem == skillMdInspector.workspaceDirectory)",
          "group": "8_refresh@1"
        },
        {
          "submenu": "skillMdInspector/context",
          "when": "view == skillMdInspectorWorkspace && (viewItem == skillMdInspector.skillFile || viewItem == skillMdInspector.favoriteSkillFile)",
          "group": "9_inspector@1"
        }
      ]
    },
    "configuration": {
      "title": "SKILL.md Inspector",
      "properties": {
        "skillMdInspector.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable deterministic validation of SKILL.md files."
        },
        "skillMdInspector.validation.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-run validation whenever a SKILL.md file is saved."
        },
        "skillMdInspector.profile": {
          "type": "string",
          "default": "generic",
          "enum": [
            "generic",
            "vscode",
            "claude",
            "codex"
          ],
          "description": "Validation profile applied to SKILL.md files."
        },
        "skillMdInspector.description.minLength": {
          "type": "number",
          "default": 40,
          "description": "Minimum recommended length of the description field."
        },
        "skillMdInspector.description.maxLength": {
          "type": "number",
          "default": 1024,
          "description": "Maximum allowed length of the description field."
        },
        "skillMdInspector.name.maxLength": {
          "type": "number",
          "default": 64,
          "description": "Maximum allowed length of the name field."
        },
        "skillMdInspector.description.language": {
          "type": "string",
          "enum": [
            "en",
            "auto"
          ],
          "default": "auto",
          "description": "Language used by description heuristics. \"en\" forces English analysis; \"auto\" detects a non-English description and marks its quality score as language-limited."
        },
        "skillMdInspector.resources.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "Glob patterns for files and folders to exclude from resource discovery. Setting this replaces the defaults."
        },
        "skillMdInspector.discovery.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/.vscode-test/**"
          ],
          "description": "Glob patterns for directories to skip when discovering SKILL.md files across the workspace (the tree view and workspace report). Setting this replaces the defaults."
        },
        "skillMdInspector.names.similarityThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Similarity (0\u20131) at or above which two different skill names are flagged as confusingly similar. Exact duplicates are always reported."
        },
        "skillMdInspector.collision.threshold": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "Composite similarity (0\u20131) at or above which two skills are reported as a potential collision."
        },
        "skillMdInspector.collision.ngramSize": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 5,
          "description": "Character n-gram size used by the collision character-similarity metric."
        },
        "skillMdInspector.collision.boundarySeparationWeight": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly mutually-exclusive \"Do not use for...\" boundaries reduce the composite collision score (0 = ignore boundaries, 1 = fully cancel overlap when scopes are mutually excluded)."
        },
        "skillMdInspector.collision.weights": {
          "type": "object",
          "properties": {
            "jaccard": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of pairwise token Jaccard."
            },
            "cosine": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of TF-IDF cosine."
            },
            "charNgram": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of character n-gram similarity."
            },
            "nameSimilarity": {
              "type": "number",
              "minimum": 0,
              "description": "Weight of skill-name similarity."
            }
          },
          "additionalProperties": false,
          "default": {
            "jaccard": 0.3,
            "cosine": 0.3,
            "charNgram": 0.2,
            "nameSimilarity": 0.2
          },
          "description": "Relative weights blended into the composite collision score. Normalized to sum to 1 at runtime, so only the ratios matter."
        },
        "skillMdInspector.body.strictness": {
          "type": "string",
          "enum": [
            "off",
            "recommended",
            "strict"
          ],
          "default": "recommended",
          "description": "How strictly to surface advisory body-section recommendations (examples, when-to-use, etc.). \"off\" disables them; \"recommended\" uses information-level diagnostics; \"strict\" uses warnings. Structural body errors are unaffected."
        },
        "skillMdInspector.severityOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "off"
            ]
          },
          "default": {},
          "description": "Override the severity of diagnostics by code, or disable one with \"off\" (e.g. { \"skill.description.vague\": \"information\" }). Specification errors are protected unless skillMdInspector.severity.allowSpecificationOverrides is enabled."
        },
        "skillMdInspector.severity.allowSpecificationOverrides": {
          "type": "boolean",
          "default": false,
          "description": "Allow skillMdInspector.severityOverrides to downgrade or disable specification-level errors (an invalid file). Off by default so structural errors are not hidden accidentally."
        },
        "skillMdInspector.experimental.llmReview.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for future LLM-assisted review. Not implemented in MVP1."
        },
        "skillMdInspector.templates": {
          "type": "array",
          "default": [],
          "description": "Custom SKILL.md templates. A non-empty array replaces the bundled templates.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "frontmatter",
              "body"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Stable unique template identifier."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Template name displayed in the selection list."
              },
              "description": {
                "type": "string",
                "description": "Optional explanation displayed in the selection list."
              },
              "frontmatter": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "YAML frontmatter lines without the opening and closing --- delimiters."
              },
              "body": {
                "type": "array",
                "items": {
                  "type": "string"
                },
