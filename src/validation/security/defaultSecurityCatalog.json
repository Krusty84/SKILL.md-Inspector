    {
      "id": "reveal-system-prompt",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})(?<!not\\s)(?<!never\\s)(?<!don't\\s)(?<!avoid\\s)\\b(?:reveal|print|repeat|show|output)\\s+(?:the\\s+|your\\s+)?(?:system|developer)\\s+(?:prompt|message|instructions?)\\b",
      "message": "attempts to extract higher-priority system or developer instructions."
    }
  ],
