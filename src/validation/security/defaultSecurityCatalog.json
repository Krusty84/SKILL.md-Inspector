  "injectionPhrases": [
    {
      "id": "ignore-previous",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})ignore\\s+(?:all\\s+)?(?:the\\s+)?previous\\s+instructions",
      "message": "prompt-injection wording that tells the agent to ignore prior instructions."
    },
    {
      "id": "disregard-above",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})disregard\\s+(?:the\\s+)?(?:above|previous|prior|earlier)",
      "message": "prompt-injection wording that tells the agent to disregard prior context."
    },
    {
      "id": "do-not-tell-user",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})do\\s+not\\s+(?:ask|tell|inform|notify|alert|warn)\\s+(?:the\\s+)?user",
      "message": "instructs the agent to act without informing the user."
    },
    {
      "id": "without-asking",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})without\\s+(?:(?:asking|telling|informing|notifying)\\s+(?:the\\s+)?user|(?:the\\s+)?user(?:'s)?\\s+confirmation|confirmation)",
      "message": "instructs the agent to act without confirmation."
    },
    {
      "id": "bypass-permission",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})(?:bypass|disable|skip|turn\\s+off|ignore)\\s+(?:\\w+\\s+){0,3}permission(?:s)?\\s+(?:prompt|approval|dialog|gate|check)s?",
      "message": "instructs the agent to bypass permission prompts."
    },
    {
      "id": "skip-permissions-flag",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})--dangerously-skip-permissions",
      "message": "invokes a flag that disables the agent's permission prompts."
    },
    {
      "id": "exfiltrate",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})\\bexfiltrat(?:e|es|ing|ion)\\b",
      "message": "references exfiltrating data."
    },
    {
      "id": "send-secrets",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})(?:print|send|leak|upload|post|transmit|reveal|dump)\\s+(?:\\w+\\s+){0,4}(?:env(?:ironment)?|secret|token|credential|api[_-]?key|password)",
      "message": "instructs the agent to send secrets or environment variables somewhere."
    },
    {
      "id": "hide-from-user",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})hide\\s+(?:this|it|that|the\\s+\\w+)\\s+from\\s+(?:the\\s+)?user",
      "message": "instructs the agent to hide activity from the user."
    },
    {
      "id": "developer-mode",
      "source": "(?<!\\b(?:never(?!\\s+mind)|not|don't|avoid|refuse\\s+to|must\\s+not|no\\s+circumstances|any\\s+circumstances)\\b[^.!?\\n]{0,60})\\byou\\s+are\\s+now\\s+(?:in\\s+)?(?:developer|debug|administrator|admin|system)\\s+mode\\b",
      "message": "attempts to replace the agent's operating role with a privileged mode."
    },
    {
      "id": "override-authority",
