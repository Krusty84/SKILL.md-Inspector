{
  "_comment": "Curated security pattern catalog. Regex sources are compiled once in patterns.ts. Command/injection/path/service patterns compile case-insensitive; secret signatures compile case-sensitive. Keep patterns anchored and low-false-positive; document any change in docs/rules.md.",
  "dangerousCommands": [
    {
      "id": "rm-rf-root",
      "source": "\\brm\\b(?=[^\\n]*?\\s-[a-zA-Z]*r)(?=[^\\n]*?\\s-[a-zA-Z]*f)[^\\n]*?\\s(?:--no-preserve-root\\s+)?(?:~|\\$HOME|\\$\\{HOME\\}|/(?:etc|usr|var|bin|sbin|boot|lib|lib64|opt|sys|proc|dev|root|home)\\b|/(?![\\w.]))",
      "message": "recursive force-delete of the filesystem root, a system directory, or the home directory; near-certainly destructive. Remove it or scope the path."
    },
    {
      "id": "fork-bomb",
      "source": ":\\s*\\(\\s*\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:",
      "message": "shell fork bomb; exhausts system resources. Remove it."
    },
    {
      "id": "dd-to-device",
      "source": "\\bdd\\b[^\\n]*\\sof=/dev/(?:sd|nvme|hd|disk|mmcblk|vd)",
      "message": "writes raw data directly to a block device; destroys the disk. Remove it."
    },
    {
      "id": "mkfs-device",
      "source": "\\bmkfs(?:\\.\\w+)?\\b[^\\n]*\\s/dev/(?:sd|nvme|hd|disk|mmcblk|vd)",
      "message": "reformats a block device; erases all data on it. Remove it."
    },
    {
      "id": "redirect-block-device",
      "source": ">\\s*/dev/(?:sd|nvme|hd|mmcblk|vd)\\w*",
      "message": "redirects output onto a raw block device; corrupts the disk. Remove it."
    },
    {
      "id": "shutdown",
      "source": "\\b(?:shutdown|poweroff|halt|reboot|init\\s+0)\\b",
      "message": "powers off or reboots the host. An agent should not run this unattended; remove it."
    },
    {
      "id": "chmod-777-root",
      "source": "\\bchmod\\s+(?:-R\\s+0?777|0?777\\s+-R)\\s+/(?![\\w])",
      "message": "recursively makes the filesystem root world-writable; catastrophic. Remove it."
    },
    {
      "id": "credential-exfil-pipe",
      "source": "\\b(?:cat|less|more|head|tail|cp|tar|gzip|base64)\\b[^\\n|]*(?:\\.ssh/|/\\.ssh|\\.aws/credentials|/etc/shadow|\\.npmrc|\\.netrc|id_rsa|id_ed25519)[^\\n|]*\\|[^\\n]*\\b(?:curl|wget|nc|ncat|netcat|scp|ssh)\\b",
      "message": "reads a credential file and pipes it to a network tool; credential exfiltration. Remove it."
    },
    {
      "id": "obfuscated-exec",
      "source": "\\b(?:base64\\s+(?:-d|--decode)|xxd\\s+-r|openssl\\s+(?:enc\\s+)?-d\\b[^\\n]*-base64|openssl\\s+base64\\s+-d)\\b[^\\n]*\\|\\s*(?:sudo\\s+)?(?:sh|bash|zsh|python|python3|perl|ruby|node)\\b",
      "message": "decodes obfuscated content and pipes it straight to an interpreter; hides what runs. Remove it."
    },
    {
      "id": "eval-download",
      "source": "\\beval\\b[^\\n]*(?:curl|wget)\\b[^\\n]*https?://",
      "message": "evaluates content downloaded from the network; runs arbitrary remote code. Remove it."
    }
  ],
  "riskyCommands": [
    {
      "id": "rm-rf-generic",
      "source": "\\brm\\b(?=[^\\n]*?\\s-[a-zA-Z]*r)(?=[^\\n]*?\\s-[a-zA-Z]*f)[^\\n]*?\\s\\S*(?:\\$\\{?\\w+\\}?|\\*|\\.\\.)\\S*",
      "message": "recursive force-delete of a variable or unquoted-glob path; the target may expand to something unintended. Quote and scope it."
    },
    {
      "id": "sudo",
      "source": "\\bsudo\\b",
      "message": "runs a command as root. Confirm elevated privileges are required."
    },
    {
      "id": "chmod-777",
      "source": "\\bchmod\\s+(?:-[a-zA-Z]+\\s+)?0?777\\b",
      "message": "makes a file world-writable. Prefer the narrowest permission that works."
    },
    {
      "id": "curl-pipe-shell",
      "source": "\\b(?:curl|wget)\\b[^\\n]*\\|\\s*(?:sudo\\s+)?(?:sh|bash|zsh|ksh)\\b",
      "message": "pipes a downloaded script straight into a shell; the content is unverified. Download, review, then run."
    },
    {
      "id": "git-push-force",
      "source": "\\bgit\\s+push\\b[^\\n]*\\s(?:--force(?!-with-lease)|-f)\\b",
      "message": "force-pushes and can overwrite remote history. Prefer --force-with-lease."
    },
    {
      "id": "dd-if",
      "source": "\\bdd\\s+if=",
      "message": "raw disk/byte copy; verify source and destination before an agent runs it."
    },
    {
      "id": "chown-recursive",
      "source": "\\bchown\\b[^\\n]*\\s-[a-zA-Z]*R",
      "message": "recursively changes ownership; verify the target path is scoped."
    },
    {
      "id": "eval",
      "source": "\\beval\\b",
      "message": "evaluates a dynamically built string as code. Avoid eval where possible."
    },
    {
      "id": "install-from-url",
      "source": "\\b(?:pip|pip3|npm|gem|yarn|pnpm)\\s+(?:install|add|i)\\b[^\\n]*https?://",
      "message": "installs a package directly from a URL, bypassing registry integrity checks. Prefer a pinned registry package."
    },
    {
      "id": "disable-firewall",
      "source": "\\b(?:iptables\\s+-F|ufw\\s+disable|setenforce\\s+0|systemctl\\s+stop\\s+firewalld)\\b",
      "message": "disables a firewall or security enforcement. Confirm this is intended."
    }
  ],
  "serviceHosts": [
