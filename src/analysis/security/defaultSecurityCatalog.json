  ],
  "secretSignatures": [
    { "id": "aws-access-key", "label": "AWS access key ID", "source": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "id": "github-token", "label": "GitHub token", "source": "\\bgh[opsur]_[A-Za-z0-9]{36}\\b" },
    { "id": "github-pat-fine", "label": "GitHub fine-grained token", "source": "\\bgithub_pat_[A-Za-z0-9_]{22,}\\b" },
    { "id": "slack-token", "label": "Slack token", "source": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b" },
    { "id": "anthropic-key", "label": "Anthropic API key", "source": "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b" },
    { "id": "openai-key", "label": "OpenAI API key", "source": "\\bsk-(?!ant-)(?:proj-)?[A-Za-z0-9]{20,}\\b" },
    { "id": "gitlab-token", "label": "GitLab token", "source": "\\bglpat-[A-Za-z0-9_-]{20}\\b" },
    { "id": "google-api-key", "label": "Google API key", "source": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "npm-token", "label": "npm token", "source": "\\bnpm_[A-Za-z0-9]{36}\\b" },
    { "id": "stripe-key", "label": "Stripe secret key", "source": "\\b(?:sk|rk)_live_[A-Za-z0-9]{20,}\\b" },
    { "id": "private-key-block", "label": "private key block", "source": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----" },
    { "id": "jwt", "label": "JSON Web Token", "source": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b" }
  ],
  "secretAssignment": {
    "id": "generic-credential",
    "label": "hardcoded credential",
    "source": "\\b(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|private[_-]?key)\\b\\s*[:=]\\s*[\"']?([^\\s\"'#`]{8,})"
  },
  "credentialedUrl": {
    "id": "credentialed-url",
    "label": "credentials embedded in a URL",
    "source": "\\b[a-z][a-z0-9+.-]*://[^\\s/@:]+:[^\\s/@:]+@"
  },
  "secretPlaceholder": {
    "source": "<[^>]*>|\\$\\{?[A-Za-z0-9_]+\\}?|%[A-Za-z0-9_]+%|x{3,}|\\*{3,}|\\.\\.\\.|\\byour[_-]|example|changeme|placeholder|redacted|dummy|sample|<redacted>"
  },
  "injectionPhrases": [
    { "id": "ignore-previous", "source": "ignore\\s+(?:all\\s+)?(?:the\\s+)?previous\\s+instructions", "message": "prompt-injection wording that tells the agent to ignore prior instructions." },
    { "id": "disregard-above", "source": "disregard\\s+(?:the\\s+)?(?:above|previous|prior|earlier)", "message": "prompt-injection wording that tells the agent to disregard prior context." },
    { "id": "do-not-tell-user", "source": "do\\s+not\\s+(?:ask|tell|inform|notify|alert|warn)\\s+(?:the\\s+)?user", "message": "instructs the agent to act without informing the user." },
    { "id": "without-asking", "source": "without\\s+(?:asking|telling|informing|notifying|confirmation|the\\s+user)", "message": "instructs the agent to act without confirmation." },
    { "id": "bypass-permission", "source": "(?:bypass|disable|skip|turn\\s+off|ignore)\\s+(?:\\w+\\s+){0,3}permissions?", "message": "instructs the agent to bypass permission prompts." },
    { "id": "skip-permissions-flag", "source": "--dangerously-skip-permissions", "message": "invokes a flag that disables the agent's permission prompts." },
    { "id": "exfiltrate", "source": "\\bexfiltrat(?:e|es|ing|ion)\\b", "message": "references exfiltrating data." },
    { "id": "send-secrets", "source": "(?:print|send|leak|upload|post|transmit|reveal|dump)\\s+(?:\\w+\\s+){0,4}(?:env(?:ironment)?|secret|token|credential|api[_-]?key|password)", "message": "instructs the agent to send secrets or environment variables somewhere." },
    { "id": "hide-from-user", "source": "hide\\s+(?:this|it|that|the\\s+\\w+)\\s+from\\s+(?:the\\s+)?user", "message": "instructs the agent to hide activity from the user." }
  ],
  "sensitivePaths": [
    { "id": "ssh-keys", "source": "(?:~|\\$HOME)?/?\\.ssh/\\S*|\\bid_(?:rsa|ed25519|ecdsa|dsa)\\b", "message": "references SSH private keys." },
    { "id": "aws-credentials", "source": "(?:~|\\$HOME)?/?\\.aws/credentials\\b", "message": "references the AWS credentials file." },
    { "id": "etc-shadow", "source": "/etc/(?:shadow|passwd|sudoers)\\b", "message": "references a system account/password file." },
    { "id": "kube-config", "source": "(?:~|\\$HOME)?/?\\.kube/config\\b", "message": "references the Kubernetes credentials file." },
    { "id": "docker-config", "source": "(?:~|\\$HOME)?/?\\.docker/config\\.json\\b", "message": "references the Docker credentials file." },
    { "id": "keychain", "source": "\\bLibrary/Keychains\\b|\\bfind-generic-password\\b|\\bsecurity\\s+find-(?:generic|internet)-password\\b", "message": "references the macOS keychain." },
    { "id": "browser-store", "source": "\\bLogin\\s+Data\\b|\\bcookies\\.sqlite\\b|\\bkey4\\.db\\b", "message": "references a browser credential/cookie store." },
    { "id": "netrc", "source": "(?:~|\\$HOME)?/?\\.netrc\\b", "message": "references the .netrc credentials file." },
    { "id": "pkg-config", "source": "(?:~|\\$HOME)?/?\\.(?:npmrc|pypirc)\\b", "message": "references a package-manager credentials file." },
    { "id": "env-secret", "source": "\\.env\\.(?:local|production|prod|secret)\\b", "message": "references an environment file that commonly holds secrets." }
  ],
  "hiddenImperative": {
    "source": "\\b(?:ignore|disregard|run|execute|exec|delete|remove|send|upload|curl|wget|eval|bypass|disable|exfiltrat|do\\s+not\\s+tell|password|token|secret|credential)\\b"
  }
}
