{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencode:session-export:17544802c38a4d35834275526ccf38be1cdcfbf4",
  "title": "OpenCode Session Export",
  "description": "Reconstructed JSON Schema for the JSON emitted by `opencode export`. It is version-pinned to the OpenCode dev branch commit recorded in `x-opencode-source-commit`; it is not an upstream-published schema.",
  "$comment": "Structural validation only. Cross-object ID equality and reference integrity must be checked separately.",
  "x-opencode-source-repository": "anomalyco/opencode",
  "x-opencode-source-branch": "dev",
  "x-opencode-source-commit": "17544802c38a4d35834275526ccf38be1cdcfbf4",
  "x-invariants": [
    "messages[*].info.sessionID must equal info.id",
    "messages[*].parts[*].sessionID must equal info.id",
    "messages[*].parts[*].messageID must equal messages[*].info.id",
    "assistant parentID should reference an existing message in the same session"
  ],
  "type": "object",
  "properties": {
    "info": {
      "$ref": "#/$defs/SessionInfo"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MessageWithParts"
      }
    }
  },
  "required": ["info", "messages"],
  "additionalProperties": false,
  "$defs": {
    "SessionID": {
      "type": "string",
      "pattern": "^ses",
      "description": "OpenCode session identifier. The source implementation only checks the 'ses' prefix."
    },
    "MessageID": {
      "type": "string",
      "pattern": "^msg",
      "description": "OpenCode message identifier. The source implementation only checks the 'msg' prefix."
    },
    "PartID": {
      "type": "string",
      "pattern": "^prt",
      "description": "OpenCode part identifier. The source implementation only checks the 'prt' prefix."
    },
    "WorkspaceID": {
      "type": "string",
      "pattern": "^wrk",
      "description": "OpenCode workspace identifier. The source implementation only checks the 'wrk' prefix."
    },
    "NonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "FiniteNumber": {
      "type": "number",
      "description": "A finite JSON number. JSON itself cannot encode NaN or Infinity."
    },
    "StringMapAny": {
      "type": "object",
      "additionalProperties": true
    },
    "StringMapString": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "StringMapBoolean": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "TokenCache": {
      "type": "object",
      "properties": {
        "read": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "write": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "additionalProperties": false,
      "required": ["read", "write"]
    },
    "Tokens": {
      "type": "object",
      "properties": {
        "total": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "input": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "output": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "reasoning": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "cache": {
          "$ref": "#/$defs/TokenCache"
        }
      },
      "additionalProperties": false,
      "required": ["input", "output", "reasoning", "cache"]
    },
    "FileDiff": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "additions": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "deletions": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "status": {
          "enum": ["added", "deleted", "modified"]
        }
      },
      "additionalProperties": false,
      "required": ["additions", "deletions"]
    },
    "PermissionRule": {
      "type": "object",
      "properties": {
        "permission": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "action": {
          "enum": ["allow", "deny", "ask"]
        }
      },
      "additionalProperties": false,
      "required": ["permission", "pattern", "action"]
    },
    "SessionSummary": {
      "type": "object",
      "properties": {
        "additions": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "deletions": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "files": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "diffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileDiff"
          }
        }
      },
      "additionalProperties": false,
      "required": ["additions", "deletions", "files"]
    },
    "SessionTime": {
      "type": "object",
      "properties": {
        "created": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "updated": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "compacting": {
          "$ref": "#/$defs/NonNegativeInteger"
        },
        "archived": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "additionalProperties": false,
      "required": ["created", "updated"]
    },
    "SessionModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "providerID": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["id", "providerID"]
    },
    "SessionRevert": {
      "type": "object",
      "properties": {
        "messageID": {
          "$ref": "#/$defs/MessageID"
        },
        "partID": {
          "$ref": "#/$defs/PartID"
        },
        "snapshot": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["messageID"]
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SessionID"
        },
        "slug": {
          "type": "string"
        },
        "projectID": {
          "type": "string"
        },
        "workspaceID": {
          "$ref": "#/$defs/WorkspaceID"
        },
        "directory": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "parentID": {
          "$ref": "#/$defs/SessionID"
        },
        "summary": {
          "$ref": "#/$defs/SessionSummary"
        },
        "cost": {
          "$ref": "#/$defs/FiniteNumber"
        },
        "tokens": {
          "$ref": "#/$defs/Tokens"
        },
        "share": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["url"]
        },
        "title": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/SessionModel"
        },
        "version": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/StringMapAny"
        },
        "time": {
          "$ref": "#/$defs/SessionTime"
        },
        "permission": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionRule"
          }
        },
        "revert": {
          "$ref": "#/$defs/SessionRevert"
        }
      },
      "additionalProperties": false,
      "required": ["id", "slug", "projectID", "directory", "title", "version", "time"]
    },
    "OutputFormatText": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        }
      },
      "additionalProperties": false,
      "required": ["type"]
    },
    "OutputFormatJsonSchema": {
      "type": "object",
      "properties": {
